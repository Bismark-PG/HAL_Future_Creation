// Embedded into the material Custom node by UpdateVolumeMaterial.py.
// UV1 contains the smooth d(weight)/d(world XY) generated by the shared ribbon.
// Differentiate the same bulge/wave formula as WPO, preserving rounded shading
// across triangles. GroundNormal supplies the original sampled ground orientation.
#if PIXELSHADER
float3 baseNormal = normalize(GroundNormal);
baseNormal = baseNormal.z < 0 ? -baseNormal : baseNormal;
float angle = 6.28318530718 * (dot(UV, WaveUV.xy) + Phase);
float height = Height + Amplitude * sin(angle);
float2 heightGradient = Gradient * height
    + Weight * Amplitude * 6.28318530718 * cos(angle) * WaveUV.xy * InvTileSize;
float3 surfaceNormal = normalize(baseNormal - float3(heightGradient * baseNormal.z, 0));
float3 exaggerated = baseNormal + (surfaceNormal - baseNormal) * clamp(NormalStrength, 0, 8);
float3 normal = exaggerated * rsqrt(max(dot(exaggerated, exaggerated), 1e-12));
float lightLength = dot(LightDirection, LightDirection);
float3 light = lightLength > 1e-8 ? LightDirection * rsqrt(lightLength) : float3(0, 0, 1);

// Relative to the sampled ground: a flat/non-deformed surface keeps its palette.
float facing = dot(normal, light) - dot(baseNormal, light);
float halfSoftness = max(Softness, 0.002) * 0.5;
float threshold = max(BandThreshold, halfSoftness);
float shadow = 1 - smoothstep(-threshold - halfSoftness, -threshold + halfSoftness, facing);
float highlight = smoothstep(threshold - halfSoftness, threshold + halfSoftness, facing);
float shade = 1 - saturate(ShadowStrength) * shadow + saturate(HighlightStrength) * highlight;
float interior = smoothstep(0, 0.12, Weight);
return BaseColor * lerp(1, shade, saturate(Strength) * interior);
#else
return BaseColor;
#endif
